# Voice Gateway - Environment variables

# Mode: tts, stt, all
# Recommended to set explicitly in production
VOICE_GATEWAY_MODE=all

# TTS
IRODORI_REPO_DIR=/path/to/Irodori-TTS
# Irodori backend: server (default) or cli
IRODORI_BACKEND=server
# Irodori-TTS-Server managed startup
IRODORI_MANAGE_SERVER=false
IRODORI_SERVER_BASE_URL=http://127.0.0.1:18790
IRODORI_SERVER_DIR=/path/to/Irodori-TTS-Server
IRODORI_SERVER_HOST=127.0.0.1
IRODORI_SERVER_PORT=18790
IRODORI_SERVER_STARTUP_TIMEOUT_SEC=300
IRODORI_SERVER_API_KEY=
IRODORI_SERVER_MODEL=irodori
AIVIS_BASE_URL=http://127.0.0.1:10101
# voice-gateway 起動時に AivisSpeech Engine も起動する
AIVIS_MANAGE_ENGINE=false
AIVIS_ENGINE_DIR=.vendor/AivisSpeech-Engine
AIVIS_STARTUP_TIMEOUT_SEC=180

# STT
REAZONSPEECH_REPO_DIR=.vendor/ReazonSpeech
# STT_CALLBACK_URL=http://127.0.0.1:8787/stt/events
# STT_CALLBACK_TIMEOUT_MS=3000

# Common
LOG_LEVEL=INFO
