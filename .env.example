# Voice Gateway - Environment variables

# Mode: tts, stt, all
# Recommended to set explicitly in production
VOICE_GATEWAY_MODE=all

# TTS
IRODORI_REPO_DIR=/path/to/Irodori-TTS

# STT
STT_VENDOR_DIR=.vendor
# STT_CALLBACK_URL=http://127.0.0.1:8787/stt/events
# STT_CALLBACK_TIMEOUT_MS=3000

# Common
LOG_LEVEL=INFO
